<Project>
  <ItemGroup>
    <PackageSourceFile Include="@(Compile)" Exclude="$(BaseIntermediateOutputPath)**;$(BaseOutputPath)**" />
  </ItemGroup>

  <Target Name="RefuseEmptyPackage" BeforeTargets="Pack" Condition="'$(IsPackable)' == 'true'">
    <Error Condition="'@(PackageSourceFile)' == ''" Code="CLAUDALISK0001" Text="$(MSBuildProjectName) is packable but has no source files. Make a package packable only once it has content." />
  </Target>
</Project>
