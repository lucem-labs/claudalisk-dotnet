<Project>
  <ItemGroup>
    <PackageSourceFile Include="$(MSBuildProjectDirectory)/**/*.cs" Exclude="$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)**;$(MSBuildProjectDirectory)/$(BaseOutputPath)**" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IsPackable)' == 'true' And Exists('$(MSBuildProjectDirectory)/README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true' And Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <PackageIcon>icon.png</PackageIcon>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' == 'true' And '$(CLAUDALISK_BASELINE_VERSION)' != '' And $([System.String]::Copy(';$(CLAUDALISK_BASELINE_PACKAGES);').Contains(';$(PackageId);'))">
    <PackageValidationBaselineVersion>$(CLAUDALISK_BASELINE_VERSION)</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <Target Name="RefuseEmptyPackage" BeforeTargets="Pack" Condition="'$(IsPackable)' == 'true'">
    <Error Condition="'@(PackageSourceFile)' == ''" Code="CLAUDALISK0001" Text="$(MSBuildProjectName) is packable but has no source files. Make a package packable only once it has content." />
  </Target>
</Project>
