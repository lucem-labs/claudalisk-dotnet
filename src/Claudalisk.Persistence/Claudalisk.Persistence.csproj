<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Claudalisk.Persistence</PackageId>
    <Description>One data source, one connection per scope, the unit of work and module DbContexts with their own schemas.</Description>
    <PackageTags>claudalisk;persistence;unit-of-work;efcore;postgresql;modular-monolith</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <InternalsVisibleTo Include="Claudalisk.Persistence.Tests" />
    <ProjectReference Include="..\Claudalisk.Persistence.Abstractions\Claudalisk.Persistence.Abstractions.csproj" />
  </ItemGroup>
</Project>
