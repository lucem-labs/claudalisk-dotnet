<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Claudalisk.Scheduling</PackageId>
    <Description>Cron schedules from configuration that send commands to modules through the dispatcher, once per scheduled time.</Description>
    <PackageTags>claudalisk;scheduling;scheduler;cron;recurring-jobs;modular-monolith</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Cronos" />
    <InternalsVisibleTo Include="Claudalisk.Scheduling.Tests" />
    <ProjectReference Include="..\Claudalisk.Dispatching\Claudalisk.Dispatching.csproj" />
    <ProjectReference Include="..\Claudalisk.Modules\Claudalisk.Modules.csproj" />
    <ProjectReference Include="..\Claudalisk.Persistence\Claudalisk.Persistence.csproj" />
  </ItemGroup>
</Project>
